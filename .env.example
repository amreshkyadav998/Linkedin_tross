# ---------------------------------------------------------------------------
# LinkedIn session  (REQUIRED for the full "voyager" data source)
# ---------------------------------------------------------------------------
# Copy the WHOLE cookie header from your browser - not just li_at.
#
#   1. Log in to linkedin.com in Chrome.
#   2. F12 -> Network tab -> reload the page.
#   3. Click any request to www.linkedin.com -> Headers -> Request Headers.
#   4. Right-click the "cookie:" line -> Copy value.
#   5. Paste the entire string on ONE line below.
#
# It should look like:  bcookie="v=2&..."; li_at=AQEDA...; JSESSIONID="ajax:12345"; lidc="b=..."
#
# Why the whole header: LinkedIn binds li_at to the browser identity carried in
# bcookie/bscookie. Sending li_at on its own looks like a replayed cookie, and
# LinkedIn invalidates the session after a few requests.
LINKEDIN_COOKIE=

# Legacy fallback - only used when LINKEDIN_COOKIE is empty. This authenticates,
# but expect the session to die quickly for the reason above.
LINKEDIN_LI_AT=
LINKEDIN_JSESSIONID=

# Alternative to LINKEDIN_COOKIE: sign in with credentials. The app performs
# the full login itself and keeps every cookie LinkedIn sets, so this reaches
# the same "full" mode as a copied header - and, unlike a copied header, the
# server can re-authenticate on its own when the session ends. That makes it
# the better option for a deployed instance, where cookies would otherwise
# need editing by hand.
#
# LINKEDIN_EMAIL accepts an email address OR a phone number.
#
# Caveat: LinkedIn answers a scripted login with a checkpoint (2FA, an emailed
# PIN, a captcha) whenever the account or the IP looks unfamiliar - which is
# common for new accounts and for cloud hosts. If that happens, sign in through
# a browser once from that network, then retry, or fall back to LINKEDIN_COOKIE.
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# ---------------------------------------------------------------------------
# This API's own settings
# ---------------------------------------------------------------------------
# If set, callers must send  X-API-Key: <value>  . Leave empty to keep it open.
API_KEY=

# Cache successful profile responses for N seconds (0 disables the cache).
CACHE_TTL_SECONDS=3600

# Max requests per client IP per minute.
RATE_LIMIT_PER_MINUTE=20

# Seconds to wait on LinkedIn before giving up.
REQUEST_TIMEOUT=25
